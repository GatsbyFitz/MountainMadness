# --- Database (Phase 0) -----------------------------------------------------
# Neon Postgres with PostGIS. Leave unset to run on the local JSON-file store.
# DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/mountainmadness?sslmode=require"

# --- Blob storage (Phase 1) -------------------------------------------------
# Vercel Blob. Leave unset to store uploads under .data/blob/ on disk.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- Terrain (Phase 2) ------------------------------------------------------
# Which TerrainSource to use: "aws" (free, no key) | "maptiler" | "custom"
NEXT_PUBLIC_TERRAIN_SOURCE="proxy"
# NEXT_PUBLIC_MAPTILER_KEY=""
# NEXT_PUBLIC_TERRAIN_TILE_URL=""   # for NEXT_PUBLIC_TERRAIN_SOURCE="custom"
